# DataMind Environment Configuration Template
# Copy this file to .env and configure local values. Never commit .env to version control.

# Application Settings
APP_ENV=development
SECRET_KEY=dev-secret-key-replace-in-production
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=datamind_user
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=datamind

# Database URL
# Host value (running tests or scripts on host): postgresql+psycopg://datamind_user:replace-with-secure-password@127.0.0.1:5432/datamind or sqlite:///./datamind.db
# Container value (inside docker compose): postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=sqlite:///./datamind.db

# Redis URL
# Host value (running on host): redis://127.0.0.1:6379/0
# Container value (inside docker compose network): redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Storage Root
# Host value (running on host): ./storage
# Container value (inside docker compose): /app/storage
STORAGE_ROOT=./storage

# LLM Provider Configuration
# Supported options: mock (default, deterministic), gemini
LLM_PROVIDER=mock
GEMINI_MODEL=gemini-2.0-flash
# Embedding Model Configuration
# Gemini embedding model used when LLM_PROVIDER=gemini (defaults to gemini-embedding-001)
EMBEDDING_MODEL=gemini-embedding-001
# Output dimensionality for vector embeddings (defaults to 768)
EMBEDDING_DIMENSION=768
# GOOGLE_API_KEY is required only when LLM_PROVIDER=gemini. Leave empty when using mock.
GOOGLE_API_KEY=

# Investigation Workflow Budget Defaults
MAX_ITERATIONS=3
COST_BUDGET_TOKENS=200000
COST_BUDGET_TOOL_CALLS=500

# Frontend & CORS
# Allowed origins for CORS in the FastAPI backend
FRONTEND_ORIGIN=http://localhost:5173
# API URL consumed by the Vite frontend
VITE_API_URL=http://localhost:8000
