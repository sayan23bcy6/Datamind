# Shared app settings
# APP_ENV: must be set locally and never committed.
APP_ENV=development
# SECRET_KEY: must be set locally and never committed.
SECRET_KEY=replace-me-local-only
# LOG_LEVEL: must be set locally and never committed.
LOG_LEVEL=INFO

# POSTGRES_USER: must be set locally and never committed.
POSTGRES_USER=change-me
# POSTGRES_PASSWORD: must be set locally and never committed.
POSTGRES_PASSWORD=change-me
# POSTGRES_DB: must be set locally and never committed.
POSTGRES_DB=datamind
# REDIS_URL is the host-side value for scripts; containers use redis://redis:6379/0.
# REDIS_URL: must be set locally and never committed.
REDIS_URL=redis://127.0.0.1:6379/0
# STORAGE_ROOT is ./storage for host use; containers use /app/storage.
# STORAGE_ROOT: must be set locally and never committed.
STORAGE_ROOT=./storage

# GOOGLE_API_KEY: must be set locally and never committed.
GOOGLE_API_KEY=replace-me-local-only
# LLM_PROVIDER: must be set locally and never committed.
LLM_PROVIDER=mock
# GEMINI_MODEL: must be set locally and never committed.
GEMINI_MODEL=gemini-2.0-flash

# Frontend
# VITE_API_URL: must be set locally and never committed.
VITE_API_URL=http://localhost:8000
